# Normalise line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Declare binary files to prevent corruption
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
